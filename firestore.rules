rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}: the signed-in user's own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // users/{uid}/gunProfiles/{gunId}: that user's rifle profiles
      match /gunProfiles/{gunId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.caliber is string
          && request.resource.data.bulletWeightGrains is number
          && request.resource.data.ballisticCoefficient is number
          && request.resource.data.muzzleVelocityFps is number
          && request.resource.data.zeroDistance is number
          && request.resource.data.scopeHeight is number
          && request.resource.data.unitSystem in ['IMPERIAL', 'METRIC'];
      }
    }

    // Everything else is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
