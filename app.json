{
  "expo": {
    "name": "AimSense",
    "slug": "aimsense",
    "version": "1.0.0",
    "scheme": "my-expo-app",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-edge-to-edge",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AimSense uses the microphone so you can speak the target distance and wind instead of typing while your hands are on the rifle.",
          "speechRecognitionPermission": "AimSense uses speech recognition to turn your spoken shot setup into distance and wind values.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.myexpoapp"
    }
  }
}
